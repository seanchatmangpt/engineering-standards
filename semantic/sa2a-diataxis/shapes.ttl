@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#> .

sa2a:CapabilityShape a sh:NodeShape ;
  sh:targetClass sa2a:Capability ;
  sh:property [ sh:path sa2a:learnedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:executedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:specifiedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:constrainedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:verifiedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:repairedBy ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:evidencedBy ; sh:minCount 1 ] .

sa2a:RepositoryProfileShape a sh:NodeShape ;
  sh:targetClass sa2a:RepositoryProfile ;
  sh:property [ sh:path sa2a:role ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path sa2a:authority ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:generator ; sh:minCount 1 ] ;
  sh:property [ sh:path sa2a:exports ; sh:minCount 1 ] .
