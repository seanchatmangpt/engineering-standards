@prefix es: <https://w3id.org/chatman/engineering-standards#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

es:WorkOrderShape a sh:NodeShape ;
  sh:targetClass es:WorkOrder ;
  sh:closed false ;

  sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 2 ] ;
  sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path dcterms:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;

  sh:property [
    sh:path es:repository ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
  ] ;

  sh:property [
    sh:path es:baseSha ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^[0-9a-f]{40}$"
  ] ;

  sh:property [
    sh:path es:graphDigest ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^[0-9a-f]{64}$"
  ] ;

  sh:property [
    sh:path es:standing ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( es:UNKNOWN es:PARTIAL_ALIVE es:ALIVE es:BLOCKED es:BUILD_BROKEN es:UNSUPPORTED es:REFUSED )
  ] ;

  sh:property [
    sh:path es:authorityCeiling ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( es:OBSERVE es:SELECT es:CONSTRUCT )
  ] ;

  sh:property [
    sh:path es:requiresCapability ;
    sh:minCount 1 ;
    sh:class es:Capability
  ] ;

  sh:property [ sh:path es:requiresCourt ; sh:minCount 1 ; sh:class es:Court ] ;
  sh:property [ sh:path es:hasFalsifier ; sh:minCount 1 ; sh:class es:CandidateFalsifier ] ;
  sh:property [ sh:path es:replayIdentity ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path es:projectionAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue es:NONE ] .

es:GeneratedArtifactShape a sh:NodeShape ;
  sh:targetClass es:GeneratedArtifact ;
  sh:property [ sh:path es:projectionOf ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path es:projectionAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue es:NONE ] .

es:EvidenceReceiptShape a sh:NodeShape ;
  sh:targetClass es:EvidenceReceipt ;
  sh:property [ sh:path es:verifiesSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path es:artifactDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] .
