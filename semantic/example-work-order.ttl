ex:work-001 a es:WorkOrder, oslc_cm:ChangeRequest ;
  dcterms:identifier "ENG-001" ;
  dcterms:title "Make engineering-standards the ecosystem root" ;
  dcterms:description "Promote the engineering standards ontology and protocol above predecessor and downstream profiles." ;
