{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/chatman/engineering-standards/authority-decision.schema.json",
  "title": "Authority Decision",
  "description": "Explicit authority admission or typed refusal for one actuation intent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_iri","intent_iri","work_order_iri","decision","policy_iri","decider_iri","decided_at"],
  "properties": {
    "decision_iri": {"type":"string","format":"uri"},
    "intent_iri": {"type":"string","format":"uri"},
    "work_order_iri": {"type":"string","format":"uri"},
    "decision": {"enum":["ADMITTED","REFUSED"]},
    "granted_authority": {"enum":["DO"]},
    "policy_iri": {"type":"string","format":"uri"},
    "decider_iri": {"type":"string","format":"uri"},
    "reason_code": {"type":"string","pattern":"^[A-Z][A-Z0-9_:-]{2,127}$"},
    "reason": {"type":"string","minLength":1},
    "decided_at": {"type":"string","format":"date-time"}
  },
  "allOf": [
    {
      "if": {"properties":{"decision":{"const":"ADMITTED"}},"required":["decision"]},
      "then": {"required":["granted_authority"],"not":{"required":["reason_code","reason"]}}
    },
    {
      "if": {"properties":{"decision":{"const":"REFUSED"}},"required":["decision"]},
      "then": {"required":["reason_code","reason"],"not":{"required":["granted_authority"]}}
    }
  ]
}
